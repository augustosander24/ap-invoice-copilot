# Address of the local Ollama server that serves the models.
OLLAMA_HOST=http://localhost:11434

# Model every agent uses unless one of the overrides below is filled in.
MODEL=llama3.1:8b

# Override the model for the agent that investigates PO invoice exceptions. Blank = use MODEL.
MODEL_PO_INVESTIGATOR=

# Override the model for the agent that investigates non-PO invoices. Blank = use MODEL.
MODEL_NONPO_INVESTIGATOR=

# Override the model for the agent that reads incoming email replies. Blank = use MODEL.
MODEL_REPLY_INTERPRETER=

# Override the model for the agent that drafts the outgoing emails. Blank = use MODEL.
MODEL_COMMUNICATOR=

# Make LangGraph refuse state values its msgpack serialiser cannot store in a checkpoint.
LANGGRAPH_STRICT_MSGPACK=true

# Reasoning per agent: on or off sends Ollama's think setting; blank sends nothing, so the model's default applies.
# A model with no thinking (llama3.1:8b) must stay blank.
THINK_PO_INVESTIGATOR=
THINK_NONPO_INVESTIGATOR=
THINK_REPLY_INTERPRETER=
THINK_COMMUNICATOR=
