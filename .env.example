# Address of the local Ollama server that serves the models.
OLLAMA_HOST=http://localhost:11434

# Model every agent uses unless one of the overrides below is filled in.
MODEL=llama3.1:8b

# The per-agent models below are the reference setup the recorded results come from: qwen3:14b for the two
# investigators and the reply interpreter, MODEL (llama3.1:8b) for the communicator. The saved runs are found
# by these model names, so keep them to replay the demo. To try another model, change its line and run that
# agent live. Blank = use MODEL.

# The agent that investigates PO invoice exceptions.
MODEL_PO_INVESTIGATOR=qwen3:14b

# The agent that investigates non-PO invoices.
MODEL_NONPO_INVESTIGATOR=qwen3:14b

# The agent that reads incoming email replies.
MODEL_REPLY_INTERPRETER=qwen3:14b

# The agent that drafts the outgoing emails.
MODEL_COMMUNICATOR=

# Make LangGraph refuse state values its msgpack serialiser cannot store in a checkpoint.
LANGGRAPH_STRICT_MSGPACK=true

# Reasoning per agent: on or off sends Ollama's think setting; blank sends nothing, so the model's default applies.
# on for qwen3:14b, as in the recorded runs. A model with no thinking (llama3.1:8b) must stay blank: Ollama
# refuses think on it.
THINK_PO_INVESTIGATOR=on
THINK_NONPO_INVESTIGATOR=on
THINK_REPLY_INTERPRETER=on
THINK_COMMUNICATOR=
